const express = require("express");
const router = express.Router();
const db = require("../database/db");

router.get("/", (req, res) => {
    const email = req.query.email;

    if (!email) {
        return res.json({ status: "error", error: "Missing email" });
    }

    db.get("SELECT isVerified FROM users WHERE email = ?", [email], (err, row) => {
        if (err) {
            console.error("isVerified error:", err);
            return res.json({ status: "error", error: "Database error" });
        }

        if (!row) {
            return res.json({ status: "ok", isVerified: 0 });
        }

        return res.json({ status: "ok", isVerified: row.isVerified });
    });
});

module.exports = router;
